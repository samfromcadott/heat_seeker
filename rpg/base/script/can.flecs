//using HseCore
//using HseRender
//using HsePhysics
using HSE

prefab prop_can {
	Position: {0,0,0}
	Rotation: {1,0,0,0}
	Velocity

	ModelOptions: {
		file: "base/models/can.obj"
	}

	BodyOptions: {
		shape: {
			type: CYLINDER,
			rotation: {0.7071068, 0.7071068, 0, 0},
			radius: 0.05,
			height: 0.15
		}
		object_layer: 1
	}
}

_ : prop_can { Position: {0,0,0.125} }
_ : prop_can { Position: {0,0.1,0.125} }
_ : prop_can { Position: {0,-0.1,0.125} }
_ : prop_can { Position: {0,0.05,0.275} }
_ : prop_can { Position: {0,-0.05,0.275} }
_ : prop_can { Position: {0,0,0.425} }
