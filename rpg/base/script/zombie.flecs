//using HseCore
//using HsePhysics
//using HseRender
using HSE

prefab missile_zombie_ball {
	Missile

	Position
	Rotation
	Velocity

	ModelOptions: {
		file: "models/ball.obj"
	}

	BodyOptions: {
		shape: {
			type: SPHERE,
			radius: 0.05,
		}
		object_layer: 1
		gravity_scale: 1.0
		sensor: true
	}

	Damage: {
		value: 10
	}
}

prefab zombie_throw {
	Weapon: {
		launch_time: 1.0
		rate: 2.6
	}

	Timer

	LaunchMissile: {
		missile: new prefab _ : missile_zombie_ball {}
		speed: 20.0
	}
}

prefab zombie_melee {
	Timer

	Weapon: {
		rate: 2.6
		launch_time: 1.0
	}

	Hitscan: {
		range: 1.0
	}

	Damage: {
		value: 10
	}
}

prefab monster_zombie {
	Position: {0,0,0}
	Rotation: {1,0,0,0}

	Monster
	Target
	Velocity
	MoveDir

	ModelOptions: {
		file: "models/zombie.glb"
	}

	Health: {
		now: 20
		max: 20
	}

	CharacterBodyOptions: {
		shape: {
			type: CAPSULE,
			rotation: {0.7071068, 0.7071068, 0, 0},
			radius: 0.25,
			height: 1.5
		}
	}

	Walk: {
		max_speed: 5.0,
		acceleration: 3.125,
		decceleration: 3.125,
		acceleration_air: 0.5,
		decceleration_air: 0.0
	}

	MeleeAttack: {
		weapon: new prefab _ : zombie_melee {}
		// weapon: new prefab _ : zombie_throw {}
		range: 2.0
	}
}
