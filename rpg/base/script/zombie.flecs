//using HseCore
//using HsePhysics
//using HseRender
using HSE

prefab zombie_melee {
	Timer

	Weapon: {
		rate: 2.6
		launch_time: 1.0
	}

	Hitscan: {
		range: 1.0
	}

	Damage: {
		value: 10
	}
}

template Zombie {
	prop position = Position: {0,0,0}
	prop rotation = Rotation: {1,0,0,0}

	Monster
	Target

	$position
	$rotation
	Velocity

	ModelOptions: {
		file: "base/models/zombie.glb"
	}

	Health: {
		now: 20
		max: 20
	}

	CharacterBodyOptions: {
		shape: {
			type: CAPSULE,
			rotation: {0.7071068, 0.7071068, 0, 0},
			radius: 0.25,
			height: 1.5
		}
	}

	GroundMovement: {
		max_speed: 5.0,
		acceleration: 3.125,
		decceleration: 3.125,
		acceleration_air: 0.5,
		decceleration_air: 0.0
	}

	MeleeAttack: {
		weapon: new _ : zombie_melee {}
		range: 2.0
	}
}

prefab monster_zombie {
	Position: {0,0,0}
	Rotation: {1,0,0,0}

	Monster
	Target
	Velocity

	ModelOptions: {
		file: "base/models/zombie.glb"
	}

	Health: {
		now: 20
		max: 20
	}

	CharacterBodyOptions: {
		shape: {
			type: CAPSULE,
			rotation: {0.7071068, 0.7071068, 0, 0},
			radius: 0.25,
			height: 1.5
		}
	}

	GroundMovement: {
		max_speed: 5.0,
		acceleration: 3.125,
		decceleration: 3.125,
		acceleration_air: 0.5,
		decceleration_air: 0.0
	}

	MeleeAttack: {
		weapon: new prefab _ : zombie_melee {}
		range: 2.0
	}
}

